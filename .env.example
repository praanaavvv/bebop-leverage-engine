# Bebop partner attribution (leave blank for demo mode — widened quotes, rate-limited)
BEBOP_SOURCE=
BEBOP_SOURCE_AUTH=

# Base RPC used by the Anvil fork and forge scripts (optional; a public one is used if unset)
BASE_RPC=

# Funded Base account, ONLY for `npm run deploy:base` (real mainnet deploy). Keep secret.
DEPLOYER_KEY=https://base-mainnet.infura.io
